{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ammo Single Activity v2 Content State",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "bundleRevision", "rows"],
  "properties": {
    "version": { "const": 2 },
    "bundleRevision": { "type": "integer", "minimum": 1 },
    "rows": {
      "type": "array", "minItems": 1, "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["windowID", "remainingBps", "displayState", "observedAt", "staleAt", "resetsAt", "sequence"],
        "properties": {
          "windowID": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$" },
          "remainingBps": { "type": ["integer", "null"], "minimum": 0, "maximum": 10000 },
          "displayState": { "enum": ["fresh", "low", "exhausted", "stale", "resetPending", "unavailable", "unlimited", "authRequired"] },
          "observedAt": { "type": ["integer", "null"] },
          "staleAt": { "type": ["integer", "null"] },
          "resetsAt": { "type": ["integer", "null"] },
          "sequence": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
