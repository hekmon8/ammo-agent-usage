"catalog.guide.amp.apiKey" = "Sign in at [ampcode.com](https://ampcode.com/settings), then create and copy an API token from the settings page.";
"catalog.guide.claude.oauth" = "Requires a Claude Pro or Max subscription signed in to Claude Code. In Terminal run `security find-generic-password -s \"Claude Code-credentials\" -w` and paste the output (or just its accessToken) above. The token expires after several hours and is not refreshed; paste a fresh one when asked to reconnect. `claude setup-token` tokens cannot read usage.";
"catalog.guide.copilot.apiKey" = "Requires a GitHub Copilot subscription: create a classic personal access token on the GitHub [Developer settings → Personal access tokens](https://github.com/settings/tokens) page and paste it above.";
"catalog.guide.deepseek.apiKey" = "Sign in to the [DeepSeek platform](https://platform.deepseek.com/api_keys), then create and copy a key on the API keys page.";
"catalog.guide.deepseek.cookie" = "Or use a web session: sign in to [platform.deepseek.com](https://platform.deepseek.com) in your browser, open the developer tools (⌥⌘I), switch to the Network tab and reload, click any request to platform.deepseek.com, then copy the full Cookie header value into the field above.";
"catalog.guide.factory.apiKey" = "Sign in at [app.factory.ai](https://app.factory.ai/settings/api-keys), then create and copy a key under Settings → API Keys.";
"catalog.guide.manus.cookie" = "Sign in to [manus.im](https://manus.im) in your browser, open the developer tools (⌥⌘I), switch to the Network tab and reload, click any request to manus.im, then copy the full Cookie header value into the field above.";
"catalog.guide.opencodego.apiKey" = "Sign in to OpenCode Zen at [opencode.ai](https://opencode.ai/auth), click Create API Key, then copy the generated key.";
"catalog.guide.opencodego.cookie" = "Or use a web session: sign in to [opencode.ai](https://opencode.ai) in your browser, open the developer tools (⌥⌘I), switch to the Network tab and reload, click any request to opencode.ai, then copy the full Cookie header value into the field above.";
"catalog.guide.openrouter.apiKey" = "Create a Management Key in [OpenRouter](https://openrouter.ai/settings/management-keys) to query account credits. Inference keys may lack balance access. Keys stay on this Mac.";
"catalog.guide.zai.apiKey" = "Create and copy an API key in the console of the platform you use: open [bigmodel.cn API Keys](https://bigmodel.cn/usercenter/proj-mgmt/apikeys) for the China site, or [z.ai API Keys](https://z.ai/manage-apikey/apikey-list) for the international site. Keys are not interchangeable — match the service region you pick.";
